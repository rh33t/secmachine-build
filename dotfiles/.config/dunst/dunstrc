[global]
    font = JetBrainsMono Nerd Font 10
    origin = top-right
    offset = (10, 42)
    corner_radius = 0
    frame_width = 2
    frame_color = "#367bf0"

[urgency_low]
    background = "#23252e"
    foreground = "#767b85"

[urgency_normal]
    background = "#23252e"
    foreground = "#e6e6e6"

[urgency_critical]
    background = "#23252e"
    foreground = "#ffffff"
    frame_color = "#d41919"
